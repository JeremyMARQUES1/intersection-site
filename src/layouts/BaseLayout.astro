---
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SkipLink from "../components/SkipLink.astro";
import "../styles/global.css";

// Import des types Netlify Identity (supprime l'erreur ts(2339))
import type {} from "../types/netlify-identity";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  publishedDate?: string;
}

const props = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Netlify Identity : doit être dans le <head> pour s'initialiser avant le DOM -->
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"
    ></script>

    <SEO {...props} />
  </head>
  <body>
    <SkipLink />
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <!-- Redirection vers /admin après connexion Netlify Identity -->
    <script>
      // On capture la référence dans une const locale
      // TypeScript peut alors garantir qu'elle reste définie dans les callbacks
      const identity = window.netlifyIdentity;

      if (identity) {
        identity.on("init", (user) => {
          if (!user) {
            identity.on("login", () => {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>
  </body>
</html>
