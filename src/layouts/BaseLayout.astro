---
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SkipLink from "../components/SkipLink.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  publishedDate?: string;
}

const props = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <SEO {...props} />
  </head>
  <body>
    <SkipLink />
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      import netlifyIdentity from "netlify-identity-widget";

      // ─── Redirect des tokens Netlify Identity ─────────────────────────────
      // Les liens d'invitation, de récupération de mot de passe et de
      // confirmation atterrissent sur la homepage avec un hash.
      // On redirige immédiatement vers /admin/ qui sait les traiter.
      const hash = window.location.hash;
      if (
        hash &&
        (hash.includes("invite_token") ||
          hash.includes("recovery_token") ||
          hash.includes("confirmation_token"))
      ) {
        window.location.replace("/admin/" + hash);
      }

      // ─── Initialisation du widget ─────────────────────────────────────────
      netlifyIdentity.init();

      netlifyIdentity.on("init", (user) => {
        if (!user) {
          netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    </script>
  </body>
</html>