---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Accueil"
  description="L'Intersection, association citoyenne pour une politique plus participative et transparente."
>
  <div class="home-hero-graphic">
      <svg
        class="home-hero-venn"
        viewBox="0 0 1080 1080"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        focusable="false"
      >
        <path
          class="venn-shape venn-shape--a"
          d="m392 917c-138.25 0-250-111.75-250-250 0-138.25 111.75-250 250-250 138.25 0 250 111.75 250 250 0 138.25-111.75 250-250 250z"
        />
        <path
          class="venn-shape venn-shape--b"
          d="m688 917c-138.25 0-250-111.75-250-250 0-138.25 111.75-250 250-250 138.25 0 250 111.75 250 250 0 138.25-111.75 250-250 250z"
        />
        <path
          class="venn-shape venn-shape--c"
          d="m540 663c-138.25 0-250-111.75-250-250 0-138.25 111.75-250 250-250 138.25 0 250 111.75 250 250 0 138.25-111.75 250-250 250z"
        />
      </svg>
    </div>
    <h1 class="home-section-title">EN CONSTRUCTION</h1>
</BaseLayout>

<style>
  /* ─── Graphique héro (logo en 3 cercles) ─── */
.home-hero-graphic {
  display: flex;
  justify-content: center;
  align-items: center;
}

.home-hero-venn {
  width: 100%;
  max-width: 420px;
  height: auto;
  overflow: visible;
  animation: home-venn-spin 100s linear infinite;
}

.venn-shape {
  mix-blend-mode: multiply;
  transform-box: fill-box;
  transform-origin: 50% 50%;
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.venn-shape--a { fill: var(--red); }
.venn-shape--b { fill: var(--green-light); }
.venn-shape--c { fill: var(--gold); }

.home-hero-venn:hover .venn-shape--a { transform: translate(-9%, 5%); }
.home-hero-venn:hover .venn-shape--b { transform: translate(9%, 5%); }
.home-hero-venn:hover .venn-shape--c { transform: translate(0, -10%); }

@keyframes home-venn-spin {
  to { transform: rotate(360deg); }
}

.home-section-title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 3rem);
  text-transform: uppercase;
  color: var(--ink);
  text-align: center;
}
</style>