---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import '../styles/home.css';

// ─── Actualités : les 3 dernières, triées par date décroissante ───
const toutesLesActus = await getCollection('actualites');
const dernieresActus = toutesLesActus
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// ─── Valeurs : les 3 premières, triées par ordre, avec leur contenu rendu ───
const toutesLesValeurs = await getCollection('valeurs');
const valeursTriees = toutesLesValeurs
  .sort((a, b) => a.data.ordre - b.data.ordre)
  .slice(0, 3);
const valeurs = await Promise.all(
  valeursTriees.map(async (valeur) => {
    const { Content } = await render(valeur);
    return { ...valeur, Content };
  })
);
---

<BaseLayout
  title="Accueil"
  description="L'Intersection."
>
  <!-- ─── Hero ─── -->
  <section class="home-hero">
    <div class="wrap">
      <div class="home-hero-text">
        <span class="eyebrow">Lorem ipsum dolor sit amet</span>
        <h1 class="home-hero-title">Nunc non diam.<br />dui at <em>risus</em>.</h1>
        <p class="home-hero-lead">
          Etiam finibus nisi id aliquam ullamcorper. Quisque bibendum in felis pellentesque pulvinar.
        </p>
        <div class="home-hero-actions">
          <a href="/qui-sommes-nous" class="home-btn home-btn-primary">Qui sommes-nous ?</a>
          <a href="/adherer" class="home-btn home-btn-secondary">Nous rejoindre</a>
        </div>
      </div>
    </div>

    <div class="home-hero-graphic">
      <svg
        class="home-hero-venn"
        viewBox="0 0 1080 1080"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        focusable="false"
      >
        <path
          class="venn-shape venn-shape--a"
          d="m392 917c-138.25 0-250-111.75-250-250 0-138.25 111.75-250 250-250 138.25 0 250 111.75 250 250 0 138.25-111.75 250-250 250z"
        />
        <path
          class="venn-shape venn-shape--b"
          d="m688 917c-138.25 0-250-111.75-250-250 0-138.25 111.75-250 250-250 138.25 0 250 111.75 250 250 0 138.25-111.75 250-250 250z"
        />
        <path
          class="venn-shape venn-shape--c"
          d="m540 663c-138.25 0-250-111.75-250-250 0-138.25 111.75-250 250-250 138.25 0 250 111.75 250 250 0 138.25-111.75 250-250 250z"
        />
      </svg>
    </div>
  </section>

  <!-- ─── Ce qui nous rassemble (Valeurs) ─── -->
  <section class="home-pillars-section">
    <div class="wrap">
      <div class="home-section-head">
        <h2 class="home-section-title">Nos valeurs</h2>
        <a href="/valeurs" class="home-link-more">Voir toutes nos valeurs →</a>
      </div>

      {valeurs.length === 0 ? (
        <p class="home-empty-state">Nos valeurs seront bientôt détaillées ici.</p>
      ) : (
        <div class="home-pillars-grid">
          {valeurs.map((valeur, i) => {
            const ValeurContent = valeur.Content;
            return (
              <article class={`home-pillar-card home-pillar-card--${i % 3}`}>
                <span class="home-pillar-index">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="home-pillar-title">{valeur.data.titre}</h3>
                <div class="home-pillar-body">
                  <ValeurContent />
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <!-- ─── Les Actus ─── -->
  <section class="home-news-section">
    <div class="wrap">
      <div class="home-section-head">
        <h2 class="home-section-title">Nos Actus</h2>
        <a href="/actualites" class="home-link-more">Voir toutes les actualités →</a>
      </div>

      {dernieresActus.length === 0 ? (
        <p class="home-empty-state">Aucun article publié pour le moment. Repassez bientôt !</p>
      ) : (
        <div class="home-news-grid">
          {dernieresActus.map((actu) => (
            <article class="home-news-card">
              <div class="home-card-meta">
                <span class="home-card-tag">{actu.data.tag}</span>
                <time datetime={actu.data.date.toISOString()}>
                  {actu.data.date.toLocaleDateString('fr-FR', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric',
                  })}
                </time>
              </div>
              <h3 class="home-card-title">{actu.data.title}</h3>
              <p class="home-card-desc">{actu.data.description}</p>
              <a href={`/actualites/${actu.id}`} class="home-card-link">
                Lire l'article <span class="sr-only">au sujet de {actu.data.title}</span>
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- ─── Bandeau d'adhésion ─── -->
  <section class="home-cta">
    <div class="wrap home-cta-inner">
      <span class="eyebrow">Rejoignez le mouvement</span>
      <h2 class="home-cta-title">Maecenas ligula enim.</h2>
      <p class="home-cta-text">
        Interdum et malesuada fames ac ante ipsum primis in faucibus. Integer sodales maximus nibh, nec gravida libero varius at. In sit amet massa sed nisl tempor faucibus.
      </p>
      <a href="/adherer" class="home-btn home-btn-primary home-btn-lg">Devenir adhérent·e</a>
    </div>
  </section>
</BaseLayout>