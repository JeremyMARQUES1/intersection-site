---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Récupération et tri des actualités par date décroissante
const toutesLesActus = await getCollection('actualites');
const dernieresActus = toutesLesActus
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout 
  title="Intersection — Accueil" 
  description="Bienvenue sur le site officiel de l'association Intersection."
>
  <section class="hero wrap">
    <span class="eyebrow">Association Intersection</span>
    <h1>INTERSECTION</h1>
    <p class="hero-lead">
      Lorem ipsum dolor sit amet, consectetur adipiscing elit. Proin sed tempus tellus.
    </p>
    <div class="hero-actions">
      <a href="/qui-sommes-nous" class="btn btn-primary">Qui sommes-nous?</a>
      <a href="/adherer" class="btn btn-secondary">Nous rejoindre</a>
    </div>
  </section>

  <section class="news-section">
    <div class="wrap">
      <div class="section-header">
        <h2 class="section-title">Les Actus</h2>
        <a href="/actualites" class="link-more">Voir toutes les actualités →</a>
      </div>

      {dernieresActus.length === 0 ? (
        <p class="empty-state">Aucun article publié pour le moment. Repassez bientôt !</p>
      ) : (
        <div class="news-grid">
          {dernieresActus.map((actu) => (
            <article class="news-card">
              <div class="card-meta">
                <span class="card-tag">{actu.data.tag}</span>
                <time datetime={actu.data.date.toISOString()}>
                  {actu.data.date.toLocaleDateString('fr-FR', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric'
                  })}
                </time>
              </div>
              <h3 class="card-title">{actu.data.title}</h3>
              <p class="card-desc">{actu.data.description}</p>
              {/* <a href={`/actualites/${actu.id}`} class="card-link">
                Lire l'article <span class="sr-only">au sujet de {actu.data.title}</span>
              </a> */}
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── Hero Section ─── */
  .hero {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
    text-align: center;
    border-bottom: 2px solid var(--ink);
  }

  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 8rem);
    line-height: 0.9;
    color: var(--ink);
    margin: var(--space-xs) 0 var(--space-md) 0;
    letter-spacing: -0.02em;
  }

  .hero-lead {
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    max-width: 720px;
    margin: 0 auto var(--space-md) auto;
    color: var(--text-muted);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    align-items: center;
  }

  /* ─── Boutons (Style Brutaliste/Éditorial) ─── */
  .btn {
    font-family: var(--font-mono);
    font-size: 14px;
    text-transform: uppercase;
    text-decoration: none;
    padding: var(--space-sm) var(--space-md);
    border: 2px solid var(--ink);
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: var(--ink);
    color: var(--paper);
  }

  .btn-primary:hover {
    background: var(--red);
    border-color: var(--red);
  }

  .btn-secondary {
    background: transparent;
    color: var(--ink);
  }

  .btn-secondary:hover {
    background: var(--paper-soft);
  }

  /* ─── Section Actualités ─── */
  .news-section {
    background: var(--paper-soft);
    padding: var(--space-xl) 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid var(--line);
    padding-bottom: var(--space-sm);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    text-transform: uppercase;
    color: var(--ink);
  }

  .link-more {
    font-family: var(--font-mono);
    font-size: 14px;
    text-decoration: none;
    color: var(--red);
    font-weight: 500;
  }
  .link-more:hover {
    color: var(--red-dark);
    text-decoration: underline;
  }

  /* ─── Grille d'actualités ─── */
  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-md);
  }

  .news-card {
    background: var(--paper);
    padding: var(--space-md);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .news-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 20px rgba(27, 27, 22, 0.05);
    border-color: var(--ink);
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .card-tag {
    background: var(--paper-soft);
    color: var(--green);
    padding: 2px 8px;
    font-weight: 500;
    border: 1px solid var(--line);
  }

  .card-meta time {
    color: var(--text-muted);
  }

  .card-title {
    font-size: 1.35rem;
    line-height: 1.3;
    font-weight: 600;
    margin-bottom: var(--space-xs);
    color: var(--ink);
  }

  .card-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: var(--space-md);
    flex-grow: 1; /* Pousse le bouton vers le bas */
  }

  .card-link {
    font-family: var(--font-mono);
    font-size: 13px;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    font-weight: 600;
    display: inline-block;
    border-bottom: 2px solid var(--red);
    align-self: flex-start;
  }

  .card-link:hover {
    color: var(--red);
  }

  .empty-state {
    font-family: var(--font-mono);
    text-align: center;
    color: var(--text-muted);
    padding: var(--space-lg) 0;
  }

  /* Responsive ajustements */
  @media (max-width: 768px) {
    .hero {
      padding-top: var(--space-lg);
      padding-bottom: var(--space-lg);
    }
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .btn {
      width: 100%;
      text-align: center;
    }
    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
    }
  }
</style>