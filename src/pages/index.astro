---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";
import { tagColors } from "../lib/tagColors";
import "../styles/home.css";

// ─── Récupération du Frontmatter de la page d'accueil ──────
const pageAccueil = await getEntry("pages", "accueil");

// 1. On rassure TypeScript en gérant le cas où le fichier n'existe pas
if (!pageAccueil) {
  throw new Error("Le fichier src/content/pages/accueil.md est introuvable.");
}

// 2. Maintenant TypeScript sait que pageAccueil existe forcément !
const data = pageAccueil.data;

// ─── Actualités ────────────────────────────────────────────
const dernieresActus = (
  await getCollection("actualites", ({ data }) => !data.draft)
)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// ─── Valeurs ───────────────────────────────────────────────
const valeurs = (await getCollection("valeurs"))
  .sort((a, b) => a.data.ordre - b.data.ordre)
  .slice(0, 3);
---

<BaseLayout title="Accueil" description={data.hero.description}>
  <!-- ─── Hero ─── -->
  <section class="home-hero">
    <div class="wrap">
      <div class="home-hero-grid">
        <div class="home-hero-text">
          <span class="eyebrow">{data.hero.eyebrow}</span>

          {
            /* set:html permet d'interpréter le <em> et le <br> tapés dans Decap CMS */
          }
          <h1 class="home-hero-title" set:html={data.hero.titre} />

          <p class="home-hero-lead">{data.hero.description}</p>

          <div class="home-hero-actions">
            <a href={data.hero.btn1_lien} class="home-btn home-btn-primary">
              {data.hero.btn1_texte}
            </a>
            <a href={data.hero.btn2_lien} class="home-btn home-btn-secondary">
              {data.hero.btn2_texte}
            </a>
          </div>
        </div>
        <div class="home-hero-graphic">
          <!-- Ton SVG en dur ici (ne change pas) -->
          <svg
            class="home-hero-venn"
            viewBox="0 0 1080 1080"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              class="venn-shape venn-shape--a"
              d="m392 917c-138.25 0-250-111.75-250-250 0-138.25 111.75-250 250-250 138.25 0 250 111.75 250 250 0 138.25-111.75 250-250 250z"
            ></path>
            <path
              class="venn-shape venn-shape--b"
              d="m688 917c-138.25 0-250-111.75-250-250 0-138.25 111.75-250 250-250 138.25 0 250 111.75 250 250 0 138.25-111.75 250-250 250z"
            ></path>
            <path
              class="venn-shape venn-shape--c"
              d="m540 663c-138.25 0-250-111.75-250-250 0-138.25 111.75-250 250-250 138.25 0 250 111.75 250 250 0 138.25-111.75 250-250 250z"
            ></path>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Valeurs ─── -->
  <section class="home-pillars-section">
    <div class="wrap">
      <div class="home-section-head">
        <h2 class="home-section-title">Nos valeurs</h2>
        <a href="/valeurs" class="home-link-more">Voir toutes nos valeurs →</a>
      </div>

      {
        valeurs.length === 0 ? (
          <p class="home-empty-state">
            Nos valeurs seront bientôt détaillées ici.
          </p>
        ) : (
          <div class="home-pillars-grid">
            {valeurs.map((valeur, i) => (
              <article class={`home-pillar-card home-pillar-card--${i % 3}`}>
                <div class="home-pillar-image-wrap">
                  {valeur.data.icone ? (
                    <img
                      src={valeur.data.icone}
                      alt=""
                      class="home-pillar-image"
                      aria-hidden="true"
                      width="400"
                      height="225"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div
                      class="home-pillar-image-placeholder"
                      aria-hidden="true"
                    />
                  )}
                </div>
                <div class="home-pillar-content">
                  <span class="home-pillar-index">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <h3 class="home-pillar-title">{valeur.data.titre}</h3>
                  <p class="home-pillar-body">{valeur.data.resume}</p>
                </div>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- ─── Actualités ─── -->
  <section class="home-news-section">
    <div class="wrap">
      <div class="home-section-head">
        <h2 class="home-section-title">Nos Actus</h2>
        <a href="/actualites" class="home-link-more"
          >Voir toutes les actualités →</a
        >
      </div>

      {
        dernieresActus.length === 0 ? (
          <p class="home-empty-state">
            Aucun article publié pour le moment. Repassez bientôt !
          </p>
        ) : (
          <div class="home-news-grid">
            {dernieresActus.map((actu) => {
              const [tagColor, tagBg] = tagColors[actu.data.tag] ?? [
                "#1c1c17",
                "#e5e5df",
              ];
              return (
                <article class="home-news-card">
                  <a
                    href={`/actualites/${actu.id}`}
                    class="home-news-card-link"
                    aria-label={`Lire l'article : ${actu.data.title}`}
                  >
                    {/* Image de couverture */}
                    <div class="home-card-image-wrap">
                      {actu.data.image ? (
                        <img
                          src={actu.data.image}
                          alt=""
                          class="home-card-image"
                          aria-hidden="true"
                          width="400"
                          height="225"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <div
                          class="home-card-image-placeholder"
                          aria-hidden="true"
                        />
                      )}
                    </div>

                    <div class="home-card-body">
                      {/* Tag coloré + date */}
                      <div class="home-card-meta">
                        <span
                          class="home-card-tag"
                          style={`color: ${tagColor}; background: ${tagBg};`}
                        >
                          {actu.data.tag}
                        </span>
                        <time
                          datetime={actu.data.date.toISOString()}
                          class="home-card-date"
                        >
                          {actu.data.date.toLocaleDateString("fr-FR", {
                            day: "numeric",
                            month: "short",
                            year: "numeric",
                          })}
                        </time>
                      </div>

                      <h3 class="home-card-title">{actu.data.title}</h3>
                      <p class="home-card-desc">{actu.data.description}</p>

                      <span class="home-card-cta" aria-hidden="true">
                        Lire l'article →
                      </span>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
        )
      }
    </div>
  </section>

<!-- ─── Bandeau d'adhésion ─── -->
  <section class="home-cta">
    <div class="wrap home-cta-inner">
      <span class="eyebrow">{data.cta.eyebrow}</span>
      <h2 class="home-cta-title">{data.cta.titre}</h2>
      <p class="home-cta-text">{data.cta.texte}</p>
      <a href={data.cta.btn_lien} class="home-btn home-btn-primary home-btn-lg">
        {data.cta.btn_texte}
      </a>
    </div>
  </section>
</BaseLayout>
