<style>
  footer {
    border-top: 1px solid var(--line);
    padding: 40px 14px 32px;
    margin-top: auto;
  }

  .foot-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .foot-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .foot-logo span {
    font-family: var(--font-display);
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  /* ─── Réseaux sociaux ─── */
  .foot-socials {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .foot-socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .foot-socials a:hover {
    color: var(--red);
    transform: translateY(-2px);
  }

  .foot-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .foot-copy {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }
  nav {
    display: flex;
    gap: 20px;
  }
  nav a {
    font-family: var(--font-mono);
    font-size: 12px;
    text-decoration: none;
    color: var(--text-muted);
    transition: color 0.15s;
  }
  nav a:hover { color: var(--red); }

  @media (max-width: 640px) {
    .foot-top { 
      /* flex-direction: column;  */
      align-items: flex-start;
      gap: 20px;
    }
    .foot-bottom { 
      flex-direction: column; 
      align-items: flex-start; 
      gap: 12px; 
    }
  }
</style>