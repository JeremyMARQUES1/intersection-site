---
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="foot-top">
      <a href="/" class="foot-logo" aria-label="L'Intersection — retour à l'accueil">
        <Logo size={28} />
        <span>L'Intersection</span>
      </a>
      <p class="foot-baseline">
        Duis lacinia ornare ultrices.
      </p>
    </div>

    <div class="foot-bottom">
      <p class="foot-copy">
        © {year} L'Intersection 
      </p>
      <nav aria-label="Liens institutionnels">
        <a href="/contact">Contact</a>
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/statuts">Statuts</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding: 40px 0 32px;
    margin-top: auto;
  }

  .foot-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .foot-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .foot-logo span {
    font-family: var(--font-display);
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  .foot-baseline {
    font-size: 13.5px;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 380px;
    text-align: right;
  }

  .foot-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .foot-copy {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }
  nav {
    display: flex;
    gap: 20px;
  }
  nav a {
    font-family: var(--font-mono);
    font-size: 12px;
    text-decoration: none;
    color: var(--text-muted);
    transition: color 0.15s;
  }
  nav a:hover { color: var(--red); }

  @media (max-width: 640px) {
    .foot-baseline { text-align: left; }
    .foot-top { flex-direction: column; }
    .foot-bottom { flex-direction: column; align-items: flex-start; gap: 12px; }
  }
</style>